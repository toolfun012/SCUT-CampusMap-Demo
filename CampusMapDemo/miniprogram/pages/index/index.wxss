.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #eef3f8;
}

.map-card {
  position: relative;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  height: 58vh;
  min-height: 560rpx;
  overflow: hidden;
  background: #dfe7ef;
}

.map-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 12rpx 14rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.35);
  background: rgba(238, 243, 248, 0.96);
}

.map-viewport {
  position: relative;
  min-height: 0;
  overflow: hidden;
  background: #dfe7ef;
}

.map-canvas {
  width: 100%;
  height: 100%;
}

.map-tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  gap: 6rpx;
  min-width: 0;
}

.tool-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 82rpx;
  height: 58rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 7rpx;
  color: #fff;
  font-size: 24rpx;
  line-height: normal;
  white-space: nowrap;
  word-break: keep-all;
  background: #475569;
}

.tool-button::after {
  border: 0;
}

.icon-button {
  min-width: 52rpx;
  padding: 0;
  font-size: 30rpx;
}

.tool-button.muted {
  background: #64748b;
}

.location-status {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 126rpx;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 10rpx;
  border-radius: 7rpx;
  color: #475569;
  font-size: 22rpx;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  word-break: keep-all;
  background: rgba(255, 255, 255, 0.78);
}

.location-status.locating {
  color: #b91c1c;
  background: rgba(254, 226, 226, 0.9);
}

.location-status.failed {
  color: #991b1b;
  background: rgba(254, 202, 202, 0.95);
}

.location-status.tracking {
  color: #166534;
  background: rgba(220, 252, 231, 0.95);
}

.zoom-text {
  min-width: 50rpx;
  color: #475569;
  font-size: 24rpx;
  text-align: center;
  white-space: nowrap;
}

.mode-switch {
  flex: 0 0 auto;
  display: flex;
  overflow: hidden;
  border: 1rpx solid rgba(37, 99, 235, 0.18);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.12);
}

.mode-item {
  min-width: 78rpx;
  padding: 16rpx 14rpx;
  color: #475569;
  font-size: 24rpx;
  text-align: center;
  white-space: nowrap;
  word-break: keep-all;
}

.mode-item.active {
  color: #fff;
  background: #2563eb;
}

.coord-chip {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  z-index: 9;
  display: block;
  padding: 12rpx 18rpx;
  border-radius: 8rpx;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.35;
  pointer-events: none;
  background: rgba(255, 255, 255, 0.72);
}

.control-scroll {
  flex: 1;
  min-height: 0;
}

.panel {
  display: grid;
  gap: 18rpx;
  padding: 22rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  color: #0f172a;
  font-size: 36rpx;
  font-weight: 700;
}

.status {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #64748b;
  font-size: 22rpx;
  background: #e2e8f0;
}

.status.ready {
  color: #166534;
  background: #dcfce7;
}

.section {
  padding: 22rpx;
  border: 1rpx solid #d7dde6;
  border-radius: 8rpx;
  background: #fbfcfe;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.input-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.field {
  display: grid;
  gap: 10rpx;
  color: #667085;
  font-size: 24rpx;
}

.field.full {
  margin-top: 18rpx;
}

input {
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid #c9d2df;
  border-radius: 7rpx;
  color: #172033;
  font-size: 28rpx;
  line-height: 76rpx;
  background: #fff;
}

.destination-box {
  position: relative;
  z-index: 5;
}

.destination-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 108rpx;
  z-index: 8;
  overflow: hidden;
  border: 1rpx solid #c9d2df;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 18rpx 42rpx rgba(16, 24, 40, 0.18);
}

.destination-list {
  max-height: 360rpx;
}

.destination-option {
  display: grid;
  gap: 4rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.destination-option:active {
  background: #eff6ff;
}

.destination-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.destination-subtitle {
  color: #667085;
  font-size: 23rpx;
  line-height: 1.35;
}

.destination-empty {
  padding: 24rpx 20rpx;
  color: #667085;
  font-size: 24rpx;
  text-align: center;
}

.primary-button,
.secondary-button {
  height: 78rpx;
  margin-top: 18rpx;
  border-radius: 7rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 78rpx;
}

.primary-button {
  background: #2563eb;
}

.secondary-button {
  color: #1f2937;
  background: #e5e7eb;
}

.exit-button {
  background: #16a34a;
}

.button-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 0 16rpx;
  color: #667085;
  font-size: 22rpx;
}

.divider::before,
.divider::after {
  content: "";
  height: 1rpx;
  flex: 1;
  background: #d7dde6;
}

.result-section {
  margin-bottom: 0;
}

.recommend-section {
  margin-bottom: 26rpx;
}

.recommendation-result {
  margin-top: 18rpx;
}

.message {
  display: block;
  min-height: 44rpx;
  margin-bottom: 16rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.result-grid {
  display: grid;
  gap: 14rpx;
}

.label {
  display: block;
  margin-bottom: 4rpx;
  color: #667085;
  font-size: 22rpx;
}

.value {
  display: block;
  color: #172033;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}
